"use client";

import { use, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import {
  ArrowLeft,
  CalendarDays,
  Check,
  CheckCircle2,
  ClipboardCheck,
  Clock3,
  Loader2,
  Save,
  Users,
  X,
  XCircle,
} from "lucide-react";

import api from "@/lib/api";

type Classroom = {
  id: number;
  school_id: number;
  level_id: number;
  name: string;
  is_active: boolean;
};

type Student = {
  id: number;
  first_name: string;
  last_name: string;
  middle_name?: string | null;
  admission_number: string;
  classroom_id?: number | null;
};

type AttendanceRecord = {
  id: number;
  school_id: number;
  student_id: number;
  classroom_id: number;
  attendance_date: string;
  status: string;
  remarks?: string | null;
};

type Status = "present" | "absent" | "late" | "excused";

const statuses: {
  value: Status;
  label: string;
}[] = [
  { value: "present", label: "Present" },
  { value: "absent", label: "Absent" },
  { value: "late", label: "Late" },
  { value: "excused", label: "Excused" },
];

function today() {
  return new Date().toISOString().slice(0, 10);
}

export default function AttendancePage({
  params,
}: {
  params: Promise<{ schoolId: string }>;
}) {
  const { schoolId } = use(params);

  const numericSchoolId = Number(schoolId);

  const [classes, setClasses] = useState<Classroom[]>([]);
  const [students, setStudents] = useState<Student[]>([]);
  const [records, setRecords] = useState<AttendanceRecord[]>([]);

  const [classroomId, setClassroomId] = useState("");
  const [attendanceDate, setAttendanceDate] = useState(today());

  const [loadingClasses, setLoadingClasses] = useState(true);
  const [loadingStudents, setLoadingStudents] = useState(false);
  const [loadingAttendance, setLoadingAttendance] = useState(false);
  const [saving, setSaving] = useState(false);

  const [statusesByStudent, setStatusesByStudent] = useState<
    Record<number, Status>
  >({});

  const [remarksByStudent, setRemarksByStudent] = useState<
    Record<number, string>
  >({});

  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  useEffect(() => {
    async function loadClasses() {
      try {
        setLoadingClasses(true);
        setError("");

        const response = await api.get("/attendance/classes");

        const data = Array.isArray(response.data)
          ? response.data
          : [];

        setClasses(data);

        if (data.length && !classroomId) {
          setClassroomId(String(data[0].id));
        }
      } catch (err: any) {
        setError(
          err?.response?.data?.detail ||
            "Unable to load attendance classes."
        );
      } finally {
        setLoadingClasses(false);
      }
    }

    loadClasses();
  }, []);

  useEffect(() => {
    if (!classroomId) {
      setStudents([]);
      setRecords([]);
      return;
    }

    async function loadData() {
      try {
        setLoadingStudents(true);
        setLoadingAttendance(true);
        setError("");
        setMessage("");

        const [studentsResponse, attendanceResponse] =
          await Promise.all([
            api.get("/students/", {
              params: {
                class_id: Number(classroomId),
              },
            }),
            api.get("/attendance", {
              params: {
                classroom_id: Number(classroomId),
                attendance_date: attendanceDate,
              },
            }),
          ]);

        const studentData = Array.isArray(studentsResponse.data)
          ? studentsResponse.data
          : [];

        const attendanceData = Array.isArray(attendanceResponse.data)
          ? attendanceResponse.data
          : [];

        setStudents(studentData);
        setRecords(attendanceData);

        const nextStatuses: Record<number, Status> = {};
        const nextRemarks: Record<number, string> = {};

        for (const record of attendanceData) {
          nextStatuses[record.student_id] =
            record.status as Status;

          nextRemarks[record.student_id] =
            record.remarks || "";
        }

        for (const student of studentData) {
          if (!nextStatuses[student.id]) {
            nextStatuses[student.id] = "present";
          }

          if (!nextRemarks[student.id]) {
            nextRemarks[student.id] = "";
          }
        }

        setStatusesByStudent(nextStatuses);
        setRemarksByStudent(nextRemarks);
      } catch (err: any) {
        setError(
          err?.response?.data?.detail ||
            "Unable to load attendance."
        );
      } finally {
        setLoadingStudents(false);
        setLoadingAttendance(false);
      }
    }

    loadData();
  }, [classroomId, attendanceDate]);

  const recordMap = useMemo(() => {
    const map = new Map<number, AttendanceRecord>();

    for (const record of records) {
      map.set(record.student_id, record);
    }

    return map;
  }, [records]);

  const summary = useMemo(() => {
    let present = 0;
    let absent = 0;
    let late = 0;
    let excused = 0;

    for (const student of students) {
      const status = statusesByStudent[student.id];

      if (status === "present") present++;
      if (status === "absent") absent++;
      if (status === "late") late++;
      if (status === "excused") excused++;
    }

    return {
      present,
      absent,
      late,
      excused,
      total: students.length,
    };
  }, [students, statusesByStudent]);

  function setStudentStatus(
    studentId: number,
    status: Status
  ) {
    setStatusesByStudent((current) => ({
      ...current,
      [studentId]: status,
    }));
  }

  function setAllStatus(status: Status) {
    const next: Record<number, Status> = {};

    for (const student of students) {
      next[student.id] = status;
    }

    setStatusesByStudent(next);
  }

  async function saveAttendance() {
    if (!classroomId || !students.length) {
      return;
    }

    try {
      setSaving(true);
      setError("");
      setMessage("");

      const classroom = classes.find(
        (item) => item.id === Number(classroomId)
      );

      if (!classroom) {
        throw new Error("Selected class was not found.");
      }

      for (const student of students) {
        const status =
          statusesByStudent[student.id] || "present";

        const remarks =
          remarksByStudent[student.id] || "";

        const existing = recordMap.get(student.id);

        if (existing) {
          await api.patch(
            `/attendance/${existing.id}`,
            {
              status,
              remarks: remarks || null,
            }
          );
        } else {
          await api.post("/attendance", {
            school_id: classroom.school_id,
            student_id: student.id,
            classroom_id: Number(classroomId),
            attendance_date: attendanceDate,
            status,
            remarks: remarks || null,
          });
        }
      }

      setMessage(
        `Attendance saved successfully for ${students.length} student${
          students.length === 1 ? "" : "s"
        }.`
      );

      const refreshed = await api.get("/attendance", {
        params: {
          classroom_id: Number(classroomId),
          attendance_date: attendanceDate,
        },
      });

      setRecords(
        Array.isArray(refreshed.data)
          ? refreshed.data
          : []
      );
    } catch (err: any) {
      setError(
        err?.response?.data?.detail ||
          err?.message ||
          "Unable to save attendance."
      );
    } finally {
      setSaving(false);
    }
  }

  const selectedClass = classes.find(
    (item) => item.id === Number(classroomId)
  );

  return (
    <div className="space-y-6">
      <Link
        href={`/dashboard/schools/${schoolId}`}
        className="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-rose-500"
      >
        <ArrowLeft size={16} />
        Back to School Workspace
      </Link>

      <section className="rounded-[28px] border border-rose-100 bg-gradient-to-br from-rose-50 via-white to-pink-50 p-7 shadow-sm">
        <div className="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
          <div>
            <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-rose-500 shadow-sm">
              <ClipboardCheck size={26} />
            </div>

            <h1 className="mt-5 text-3xl font-bold text-slate-900">
              Attendance
            </h1>

            <p className="mt-2 max-w-2xl text-sm text-slate-500">
              Record and monitor daily student attendance.
            </p>
          </div>

          <div className="rounded-2xl bg-white px-5 py-4 shadow-sm">
            <p className="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Attendance Date
            </p>

            <div className="mt-2 flex items-center gap-2">
              <CalendarDays size={18} className="text-rose-500" />

              <input
                type="date"
                value={attendanceDate}
                onChange={(event) =>
                  setAttendanceDate(event.target.value)
                }
                className="border-0 bg-transparent text-sm font-bold text-slate-800 outline-none"
              />
            </div>
          </div>
        </div>
      </section>

      {error && (
        <div className="flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          <XCircle size={18} className="mt-0.5 shrink-0" />
          <span>{error}</span>
        </div>
      )}

      {message && (
        <div className="flex items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-700">
          <CheckCircle2 size={18} className="mt-0.5 shrink-0" />
          <span>{message}</span>
        </div>
      )}

      <section className="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div className="grid gap-5 md:grid-cols-[1fr_auto]">
          <div>
            <label className="mb-2 block text-sm font-bold text-slate-700">
              Select Class
            </label>

            <select
              value={classroomId}
              onChange={(event) =>
                setClassroomId(event.target.value)
              }
              disabled={loadingClasses}
              className="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-800 outline-none transition focus:border-rose-400 focus:ring-2 focus:ring-rose-100"
            >
              <option value="">
                {loadingClasses
                  ? "Loading classes..."
                  : "Select class"}
              </option>

              {classes.map((classroom) => (
                <option
                  key={classroom.id}
                  value={classroom.id}
                >
                  {classroom.name}
                </option>
              ))}
            </select>
          </div>

          <div className="flex items-end">
            <button
              type="button"
              onClick={() => setAllStatus("present")}
              disabled={!students.length}
              className="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
            >
              <Check size={17} />
              Mark All Present
            </button>
          </div>
        </div>
      </section>

      {selectedClass && (
        <section className="grid grid-cols-2 gap-3 md:grid-cols-5">
          <SummaryCard
            icon={<Users size={18} />}
            label="Students"
            value={summary.total}
          />

          <SummaryCard
            icon={<CheckCircle2 size={18} />}
            label="Present"
            value={summary.present}
          />

          <SummaryCard
            icon={<XCircle size={18} />}
            label="Absent"
            value={summary.absent}
          />

          <SummaryCard
            icon={<Clock3 size={18} />}
            label="Late"
            value={summary.late}
          />

          <SummaryCard
            icon={<CheckCircle2 size={18} />}
            label="Excused"
            value={summary.excused}
          />
        </section>
      )}

      <section className="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        <div className="flex flex-col gap-3 border-b border-slate-100 px-6 py-5 md:flex-row md:items-center md:justify-between">
          <div>
            <h2 className="text-xl font-bold text-slate-900">
              {selectedClass?.name || "Student Attendance"}
            </h2>

            <p className="mt-1 text-sm text-slate-500">
              {attendanceDate}
            </p>
          </div>

          <button
            type="button"
            onClick={saveAttendance}
            disabled={
              saving ||
              loadingStudents ||
              loadingAttendance ||
              !students.length
            }
            className="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {saving ? (
              <Loader2 size={17} className="animate-spin" />
            ) : (
              <Save size={17} />
            )}

            {saving ? "Saving..." : "Save Attendance"}
          </button>
        </div>

        {loadingStudents || loadingAttendance ? (
          <div className="flex min-h-[280px] items-center justify-center">
            <div className="flex items-center gap-3 text-sm font-semibold text-slate-500">
              <Loader2 size={20} className="animate-spin" />
              Loading attendance...
            </div>
          </div>
        ) : !classroomId ? (
          <div className="p-12 text-center">
            <ClipboardCheck
              size={42}
              className="mx-auto text-slate-300"
            />

            <h3 className="mt-4 font-bold text-slate-700">
              Select a class
            </h3>

            <p className="mt-1 text-sm text-slate-400">
              Choose a class above to begin recording attendance.
            </p>
          </div>
        ) : !students.length ? (
          <div className="p-12 text-center">
            <Users
              size={42}
              className="mx-auto text-slate-300"
            />

            <h3 className="mt-4 font-bold text-slate-700">
              No students found
            </h3>

            <p className="mt-1 text-sm text-slate-400">
              There are no students assigned to this class.
            </p>
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full min-w-[900px]">
              <thead>
                <tr className="border-b border-slate-100 bg-slate-50/70 text-left text-xs font-bold uppercase tracking-wide text-slate-500">
                  <th className="px-6 py-4">Student</th>
                  <th className="px-4 py-4">Admission No.</th>
                  <th className="px-4 py-4">Attendance</th>
                  <th className="px-4 py-4">Remarks</th>
                  <th className="px-6 py-4 text-right">Record</th>
                </tr>
              </thead>

              <tbody>
                {students.map((student, index) => {
                  const status =
                    statusesByStudent[student.id] ||
                    "present";

                  const existing =
                    recordMap.get(student.id);

                  return (
                    <tr
                      key={student.id}
                      className="border-b border-slate-100 last:border-0 hover:bg-slate-50/50"
                    >
                      <td className="px-6 py-4">
                        <div className="flex items-center gap-3">
                          <div className="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-50 text-xs font-bold text-rose-600">
                            {index + 1}
                          </div>

                          <div>
                            <p className="font-bold text-slate-800">
                              {student.first_name}{" "}
                              {student.middle_name
                                ? `${student.middle_name} `
                                : ""}
                              {student.last_name}
                            </p>
                          </div>
                        </div>
                      </td>

                      <td className="px-4 py-4 text-sm font-semibold text-slate-500">
                        {student.admission_number}
                      </td>

                      <td className="px-4 py-4">
                        <div className="flex flex-wrap gap-2">
                          {statuses.map((item) => {
                            const active =
                              status === item.value;

                            return (
                              <button
                                key={item.value}
                                type="button"
                                onClick={() =>
                                  setStudentStatus(
                                    student.id,
                                    item.value
                                  )
                                }
                                className={[
                                  "rounded-lg px-3 py-2 text-xs font-bold transition",
                                  active
                                    ? item.value === "present"
                                      ? "bg-emerald-600 text-white"
                                      : item.value === "absent"
                                      ? "bg-red-600 text-white"
                                      : item.value === "late"
                                      ? "bg-amber-500 text-white"
                                      : "bg-sky-600 text-white"
                                    : "bg-slate-100 text-slate-500 hover:bg-slate-200",
                                ].join(" ")}
                              >
                                {item.label}
                              </button>
                            );
                          })}
                        </div>
                      </td>

                      <td className="px-4 py-4">
                        <input
                          type="text"
                          value={
                            remarksByStudent[student.id] || ""
                          }
                          onChange={(event) =>
                            setRemarksByStudent((current) => ({
                              ...current,
                              [student.id]:
                                event.target.value,
                            }))
                          }
                          placeholder="Optional"
                          className="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm outline-none focus:border-rose-400"
                        />
                      </td>

                      <td className="px-6 py-4 text-right">
                        {existing ? (
                          <span className="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700">
                            <CheckCircle2 size={14} />
                            Recorded
                          </span>
                        ) : (
                          <span className="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-700">
                            Pending
                          </span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  );
}

function SummaryCard({
  icon,
  label,
  value,
}: {
  icon: React.ReactNode;
  label: string;
  value: number;
}) {
  return (
    <div className="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
      <div className="flex items-center gap-2 text-slate-400">
        {icon}
        <span className="text-xs font-bold uppercase tracking-wide">
          {label}
        </span>
      </div>

      <p className="mt-2 text-2xl font-black text-slate-900">
        {value}
      </p>
    </div>
  );
}
