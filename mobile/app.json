{
  "expo": {
    "name": "PreSense",
    "slug": "presense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/presense-logo.png",
    "scheme": "presense",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/presense-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/presense-logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/presense-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
