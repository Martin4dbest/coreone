{
  "expo": {
    "name": "PreSense",
    "slug": "presense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/presense-logo.png",
    "scheme": "presense",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/presense-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/presense-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.martin4dbest.presense"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/presense-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0989a34a-dce8-4145-8384-b055098c70d1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0989a34a-dce8-4145-8384-b055098c70d1"
    }
  }
}
