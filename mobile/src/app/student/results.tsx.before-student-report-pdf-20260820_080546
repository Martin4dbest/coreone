        throw new Error(
          "The server returned an empty academic report."
        );
      }

      setReport(data);
    } catch (e: any) {
      console.log(
        "STUDENT REPORT ERROR:",
        e?.response?.data || e
      );

      setError(
        e?.response?.data?.detail ||
          e?.response?.data?.message ||
