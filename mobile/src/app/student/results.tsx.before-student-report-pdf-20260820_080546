    name: string;
    admission_number: string;
    passport: string | null;
    class: string | null;
  };
  school: {
    name: string;
    logo: string | null;
    motto: string | null;
    primary_color?: string | null;
    accent_color?: string | null;
  };
  subjects: Subject[];
  total: number;
  average: number;
  position: number | null;
  attendance: number;
  remark: string;
  comments: {
    teacher: string | null;
    principal: string | null;
  };
